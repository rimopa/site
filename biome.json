{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUnknownTypeSelector": "off"
      }
    }
  },
  "html": {
    "parser": {
      "interpolation": true
    }
  },
  "files": {
    "includes": ["layouts/**", "static/**", "!static/*.html"]
  }
}
